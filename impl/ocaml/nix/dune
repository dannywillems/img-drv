; The Nix front-end is a SEPARATE library from img_drv on purpose: the IR core
; has zero runtime dependencies and should keep them, while this one is
; generated by ocamllex and menhir.
(library
 (name img_drv_nix)
 (libraries img_drv)
 ; -45 is deliberate: Ast and Value share constructor names (Int, Float, Str,
 ; Path, List, Lambda) because they model the same concepts at two levels, the
 ; syntax and the runtime value. Renaming one side to silence the warning would
 ; make every match read worse than the shadowing does.
 (flags
  (:standard -w +a-4-9-40-42-44-45-70 -warn-error +a)))

(ocamllex lexer)

; dune generates parser.conflicts by default, which is the whole reason for
; using a generator rather than a hand-written parser: an ambiguity is REPORTED
; here instead of being silently resolved by whichever branch was written
; first. --strict turns menhir's warnings into errors.
(menhir
 (modules parser)
 (flags --strict))
