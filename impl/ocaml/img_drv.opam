# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "A portable, content-addressed IR for reproducible build descriptions"
description:
  "Describe a build, compute its store paths, serialize it, and get bytes identical to what Nix emits. The OCaml implementation is the typed reference: variants for every sum, abstract types so invalid values are unconstructible."
maintainer: ["danny@badaas.be"]
authors: ["Danny Willems"]
license: "MPL-2.0"
tags: ["reproducible-builds" "nix" "derivation" "build-system"]
homepage: "https://github.com/dannywillems/img-drv"
bug-reports: "https://github.com/dannywillems/img-drv/issues"
depends: [
  "ocaml" {>= "5.5.0"}
  "dune" {>= "3.24"}
  "alcotest" {>= "1.9.0" & with-test}
  "ocamlformat" {>= "0.29.0" & with-dev-setup}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/dannywillems/img-drv.git"
x-maintenance-intent: ["(latest)"]
