(lang dune 3.24)
(name img_drv)
(generate_opam_files true)

(formatting
 (enabled_for ocaml))

(source
 (github dannywillems/img-drv))

(license MPL-2.0)
(authors "Danny Willems")
(maintainers "danny@badaas.be")

; The opam package is defined HERE and nowhere else. `generate_opam_files`
; produces img_drv.opam from this stanza; that file is committed because dune
; requires the promoted copy to exist, and it carries a "generated by dune,
; edit dune-project instead" header. Never edit it by hand: dune will diff it
; against this stanza and fail the build.
(package
 (name img_drv)
 (synopsis
  "A portable, content-addressed IR for reproducible build descriptions")
 (description
  "Describe a build, compute its store paths, serialize it, and get bytes identical to what Nix emits. The OCaml implementation is the typed reference: variants for every sum, abstract types so invalid values are unconstructible.")
 (tags
  (reproducible-builds nix derivation build-system))
 (depends
  (ocaml
   (>= 5.5.0))
  (dune
   (>= 3.24))
  (alcotest
   (and
    (>= 1.9.0)
    :with-test))
  (ocamlformat
   (and
    (>= 0.29.0)
    :with-dev-setup))))

; The OCaml implementation is the TYPED REFERENCE. Variants for every sum,
; abstract types in .mli files so invalid values are unconstructible, and
; warnings as errors. See README.md for what that buys over the other three.
