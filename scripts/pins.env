# Pinned tool images. Everything runs in a container: nothing is installed on
# the host, so a laptop and a CI runner run the same code.
#
# The Nix version this project is verified against.
#
# Pinned by DIGEST, not by tag: a tag is a mutable pointer, and a
# reproducibility project cannot have a fuzzy oracle. Changing either line is
# a deliberate commit whose diff shows exactly what moved.
#
# Stability, measured rather than assumed: 2.34.8 and 2.35.1 emit
# byte-identical derivations for a probe exercising multiple outputs, a
# dependency edge and unsorted env keys. So the format is stable across at
# least one minor release, and the differential job is what tells us when
# that stops being true.
NIX_VERSION=2.35.1
NIX_IMAGE=nixos/nix:2.35.1@sha256:377d4887aca98f0dfa12971c1ea6d6a625a435d8b610d4c95a436843da6fbfd1

# The Python used to RUN the implementation in CI and locally. Pinned for the
# same reason: a check that behaves differently on two machines is not a check.
# The library itself supports 3.11 and newer; this is only what executes it.
PY_IMAGE=python:3.14-slim@sha256:cea0e6040540fb2b965b6e7fb5ffa00871e632eef63719f0ea54bca189ce14a6
